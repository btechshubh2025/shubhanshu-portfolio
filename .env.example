# Copy this file to .env and fill it in. Never commit .env.

# MySQL connection. Leave empty to use a local SQLite file while developing.
# Local MySQL:  mysql+pymysql://portfolio:YOUR_PASSWORD@localhost:3306/portfolio?charset=utf8mb4
# AWS RDS:      mysql+pymysql://portfolio:YOUR_PASSWORD@your-db.xxxxxx.ap-south-1.rds.amazonaws.com:3306/portfolio?charset=utf8mb4
DATABASE_URL=

# Set to 1 when running behind nginx or a load balancer (EC2 setup in README.md).
BEHIND_PROXY=0

# Optional inbox page at /admin/messages. Set both to turn it on, leave empty to keep it off.
ADMIN_USER=
ADMIN_PASSWORD=

# Local development only.
FLASK_DEBUG=0
PORT=5000
