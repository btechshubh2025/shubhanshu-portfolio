# Copy to /etc/systemd/system/portfolio.service
# Assumes the project is in /home/ubuntu/portfolio and the virtualenv is /home/ubuntu/portfolio/venv.
# On Amazon Linux, change "ubuntu" to "ec2-user" in the three places below.

[Unit]
Description=Portfolio website (gunicorn)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/portfolio
ExecStart=/home/ubuntu/portfolio/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
